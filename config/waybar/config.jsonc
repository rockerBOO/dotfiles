[
  {
    "name": "main",
    // "height": ,
    "output": "DP-3",
    "modules-left": ["mango/workspaces", "mango/layout", "mango/window"],
    "modules-right": ["memory", "clock"],
    "mango/layout": {
      "format": "{symbol}",
    },
    "mango/window": {
      "format": "{title}",
      "expand": true,
      "escape": true,
      // "icon": true,
      // "icon-size": 20,
    },
    "mango/workspaces": {
      // "format": "{icon}",
      // "format-icons": {
      //   "1": "一",
      //   "2": "二",
      //   "active": "",
      //   "default": "",
      //   "urgent": "",
      //   "empty": "",
      // },
      "on-click": "activate",
      "on-click-right": "toggle",
      // "overview-label": "",
    },
    "memory": {
      "interval": 30,
      "format": "{used:0.1f}G",
    },
    "clock": {
      "format": "{:%H:%M}",
      "format-alt": "{:%a, %b %d %C%y}",
      "tooltip": false,
      "on-click-right": "gsimplecal",
    },
    "reload_style_on_change": true,
  },
  {
    "name": "side",
    "output": "HDMI-A-1",
    "modules-left": ["mango/workspaces", "mango/layout", "mango/window"],
    "modules-right": ["memory", "clock"],
    "mango/layout": {
      "format": "{symbol}",
    },
    "mango/window": {
      "format": "{title}",
      "expand": true,
      "escape": true,
      // "icon": true,
      // "icon-size": 24,
    },
    "mango/workspaces": {
      // "format": "{icon}",
      // "format-icons": {
      //   "1": "一",
      //   "2": "二",
      //   "active": "",
      //   "default": "",
      //   "urgent": "",
      //   "empty": "",
      // },
      "on-click": "activate",
      "on-click-right": "toggle",
      // "overview-label": "",
    },
    "memory": {
      "interval": 30,
      "format": "{used:0.1f}G",
    },
    "clock": {
      "format": "{:%H:%M}",
      "format-alt": "{:%a, %b %d %C%y}",
      "tooltip": false,
      "on-click-right": "gsimplecal",
    },
    "reload_style_on_change": true,
  },
]
